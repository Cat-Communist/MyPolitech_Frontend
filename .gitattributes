# Переводы строк: в репозитории и в рабочей копии всегда LF.
# eol=lf перекрывает глобальный core.autocrlf, поэтому на любой машине
# (в том числе на Windows с autocrlf=true) файлы останутся с LF.
* text=auto eol=lf

# Текстовые файлы проекта — явно.
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.svg   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf

# Растровая графика — бинарники, не трогать и не diff-ить.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary

# Шрифты — бинарники (понадобятся на шаге 4).
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
